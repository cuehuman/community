# Your agent's key from the CueHuman Developer Portal. Use a cue_test_ key while you try this.
CUEHUMAN_API_KEY=cue_test_your_key_here

# Who approves the agent's calls. With a test key, this must be a member of your CueHuman organization.
APPROVER_EMAIL=you@example.com

# The webhook profile that points at this sample's /webhooks/cuehuman endpoint:
# its name, and its signing secret (shown once, when you turn signing on).
CUEHUMAN_WEBHOOK_NAME=your_webhook_profile_name
CUEHUMAN_WEBHOOK_SECRET=whsec_your_signing_secret

# The model the agent runs on, and that provider's key.
MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=your_model_provider_key

# Optional: how long the person has to answer, in seconds. When not set, 10 days.
# CUEHUMAN_EXPIRES_IN_SECONDS=86400

# Optional: record every run in LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=cuehuman-approval-gate
