# Your agent's key from the CueHuman Developer Portal. Use a cue_test_ key while you try this.
CUEHUMAN_API_KEY=cue_test_your_key_here

# The webhook profile that points at this server's /webhooks/cuehuman route:
# its name, and its signing secret (shown once, when you turn signing on).
CUEHUMAN_WEBHOOK_NAME=your_webhook_profile_name
CUEHUMAN_WEBHOOK_SECRET=whsec_your_signing_secret

# For start_run.py and show_run.py: where the server is, and your LangSmith API key.
# With `langgraph dev` the address is http://localhost:2024.
LANGGRAPH_URL=http://localhost:2024
LANGSMITH_API_KEY=your_langsmith_key

# Optional: how long the human has to answer, in seconds. When not set, 10 days.
# CUEHUMAN_EXPIRES_IN_SECONDS=86400
