# Your agent's key from the CueHuman Developer Portal. Use a cue_test_ key while you try this.
CUEHUMAN_API_KEY=cue_test_your_key_here

# Who the agent asks. With a test key, this must be a member of your CueHuman organization.
APPROVER_EMAIL=you@example.com

# The model the agent runs on, and that provider's key.
MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=your_model_provider_key

# Optional: record every run in LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=cuehuman-ask-human
